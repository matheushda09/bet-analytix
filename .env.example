# Userbot MTProto para sinais de terceiros
# Reage a mensagens de sinais externos no chat alvo:
#   👍 = aposta simples   |   ❤️ = aposta acumuladora/multipla
USERBOT_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_USERBOT_SESSION=data/telegram_userbot.session
USERBOT_TARGET_CHAT=
# Opcional: deixe vazio para aceitar qualquer admin do chat, desde que a mensagem tenha o marcador "Jogue com responsabilidade".
USERBOT_SIGNAL_SENDER_IDS=
USERBOT_SIGNAL_SENDER_ID=
TELEGRAM_SIGNAL_SENDER_ID=
USERBOT_BET_ANALYTIX_TIPSTER_NAME=PeixeEsperto
USERBOT_SQLITE_PATH=data/userbot_signals.sqlite3
USERBOT_REACTION_MAX_AGE_SECONDS=300
USERBOT_QUEUE_BATCH_SIZE=5
USERBOT_RETRY_MAX_SECONDS=900
USERBOT_POLL_INTERVAL_SECONDS=5
# Escaneia o historico recente uma unica vez para marcar reacoes proprias antigas.
# O userbot grava internamente quando o baseline termina; reinicios seguintes pulam o scan.
USERBOT_BASELINE_SCAN_LIMIT=1000
# Segunda linha de defesa: revisita mensagens recentes para capturar reacoes cujo update MTProto tenha sido perdido.
USERBOT_RECONCILE_INTERVAL_SECONDS=60
USERBOT_RECONCILE_SCAN_LIMIT=1000
# Recupera reacoes ativas ja conhecidas pelo baseline, mas sem job, apenas em mensagens recentes.
USERBOT_RECOVER_KNOWN_WITHOUT_JOB_MAX_AGE_SECONDS=259200
USERBOT_NOTIFY_ON_SUCCESS=true
# Obrigatorio para perguntar ao admin quando a casa nao for encontrada.
# Vazio usa TELEGRAM_ADMIN_USER_ID (seu privado).
USERBOT_NOTIFY_CHAT_ID=
USERBOT_EVENT_TIME_MODE=message_time
USERBOT_BOOKMAKER_ALIASES_JSON={}
# Bot Discord oficial OU self-bot (conta de usuario) para sinais externos por reacao.
# Preencha DISCORD_BOT_TOKEN para bot oficial ou DISCORD_USER_TOKEN para logar na sua conta pessoal.
# Aviso: self-bots violam os Termos de Servico do Discord e podem banir a conta.
DISCORD_REACTION_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_USER_TOKEN=
DISCORD_GUILD_ID=1517366895366639641
DISCORD_CHANNEL_ID=1517366966409756712
DISCORD_ADMIN_USER_ID=
DISCORD_BET_ANALYTIX_TIPSTER_NAME=PeixeEsperto
DISCORD_SQLITE_PATH=data/discord_signals.sqlite3
DISCORD_QUEUE_BATCH_SIZE=5
DISCORD_RETRY_MAX_SECONDS=900
DISCORD_POLL_INTERVAL_SECONDS=5
DISCORD_NOTIFY_ON_SUCCESS=true
# Opcional. Vazio usa TELEGRAM_ADMIN_USER_ID, ou seja, seu privado.
DISCORD_NOTIFY_CHAT_ID=
# Envia DM no Discord para o admin quando uma aposta for planilhada.
DISCORD_NOTIFY_DM_ON_SUCCESS=true
DISCORD_BOOKMAKER_ALIASES_JSON={}
RUNNER_RESTART_DELAY_SECONDS=10

# Sincronizacao automatica de resultados do PeixeEsperto (resultados.peixeesperto.com.br)
# Requer DISCORD_REACTION_BOT_ENABLED=true. O sync busca apostas ja enviadas ao Bet-Analytix e
# atualiza seu status para Ganha/Perdida quando o tipster marcar no site.
PEIXEESPERTO_RESULT_SYNC_ENABLED=false
PEIXEESPERTO_GROUP_SLUG=aguas-profundas
PEIXEESPERTO_SYNC_INTERVAL_SECONDS=300
PEIXEESPERTO_SYNC_MAX_AGE_HOURS=72
PEIXEESPERTO_SYNC_PER_PAGE=50
PEIXEESPERTO_SYNC_MAX_PAGES=10

# Catálogos opcionais
SPORT_NAMES_JSON={"1":"Futebol","2":"Tênis","3":"Basquete"}
BOOKMAKER_NAMES_JSON={}

# Fuzzy matching de casas no Bet-Analytix.
# Quando o nome da casa no sinal nao da match exato, o sistema tenta encontrar a
# casa mais proxima no catalogo da API. Valor 0-100; padrao 80. Desative com 100.
BOOKMAKER_FUZZY_MATCH_THRESHOLD=80
